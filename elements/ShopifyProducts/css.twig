%%SELECTOR%% .bde-shopify-product-title {
    margin: 0;
    font-size: 1.2rem;
    color: inherit;
    {{ typography.title_typography }}
}

%%SELECTOR%% .bde-shopify-product-price {
    font-weight: bold;
    margin-top: 5px;
    {{ typography.price_typography }}
}

%%SELECTOR%% .bde-shopify-product-link {
    text-decoration: none;
    color: inherit;
    display: block;
}

%%SELECTOR%% .bde-shopify-product-button {
    transition: opacity 0.3s;
    {{ typography.button_typography }}
}

%%SELECTOR%% .bde-shopify-product-button:hover {
    opacity: 0.8;
}
